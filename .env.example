# ==============================================================================
# Deepgram Voice Agent API Configuration (Server-side only)
# ==============================================================================
# Used to mint short-lived (30s) session tokens via /api/deepgram-token
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ==============================================================================
# Post-Interview Scoring LLM Provider Configuration
# ==============================================================================
# Selected scoring provider: "anthropic" | "openai" | "gemini"
# If not explicitly set, auto-detects based on whichever API key is configured below.
SCORING_LLM_PROVIDER=anthropic

# Anthropic Claude API (Required only if SCORING_LLM_PROVIDER=anthropic or default)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# OpenAI API (Required only if SCORING_LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# Google Gemini API (Required only if SCORING_LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# ==============================================================================
# Supabase Configuration
# ==============================================================================
# Public URL and Anon Key for client and public access
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key for server-side trusted DB inserts and transcript compiles
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ==============================================================================
# GitHub API (Optional)
# ==============================================================================
# Raises GitHub public repo and README rate limit from 60/hr to 5,000/hr
GITHUB_TOKEN=
