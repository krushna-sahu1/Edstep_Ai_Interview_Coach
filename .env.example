# Deepgram Voice Agent API Key (Server-side only)
# Used to mint short-lived session tokens via /api/deepgram-token
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Anthropic API Key (Server-side only)
# Used for Claude post-interview transcript evaluation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Configuration
# Public URL and Anon Key for client and public access
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role Key for server-side trusted DB inserts and transcript compiles
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional: GitHub Personal Access Token (raises rate limit from 60/hr to 5,000/hr)
GITHUB_TOKEN=
